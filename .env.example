# DSIC-2706 Environment Configuration Template
# Salin berkas ini ke .env sebelum menjalankan eksperimen jika perlu kustomisasi path

PROJECT_NAME="DSIC-2706-Bioacoustic-Retrieval"
DATA_DIR="data"
CONFIG_DIR="configs"
RESULTS_DIR="results"
RANDOM_SEED=42

# Device selection for deep representations (cpu / cuda)
TORCH_DEVICE="cpu"

# Xeno-Canto API Settings (Opsional jika ingin scraping tambahan)
XENO_CANTO_API_URL="https://xeno-canto.org/api/2/recordings"
